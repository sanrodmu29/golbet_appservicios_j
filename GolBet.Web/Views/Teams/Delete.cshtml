@model GolBet.Services.DTOs.TeamDto
@{
    ViewData["Title"] = "Eliminar equipo";
}

<h2 class="mb-3">Eliminar equipo</h2>

<div class="alert alert-warning">
    ¿Seguro que quieres eliminar a <strong>@Model.Name</strong> (@Model.City)?
    El equipo se desactiva; no se borra de la base de datos.
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
